rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && "admin" in request.auth.token
        && request.auth.token.admin == true;
    }

    function isConversationParticipant(conversationId) {
      return signedIn()
        && request.auth.uid in get(
          /databases/$(database)/documents/conversations/$(conversationId)
        ).data.participantIds;
    }

    // Keep reservation and slot status in sync.
    function reservationSlotMatchesAfter(
      reservationId,
      previousReservation,
      nextReservation
    ) {
      return (
        previousReservation.keys().hasAll([
          "dateKey",
          "timeString",
          "timeKey"
        ])
        && existsAfter(
          /databases/$(database)/documents/provider_booked_slots/$(previousReservation.providerId)/dates/$(previousReservation.dateKey)/times/$(previousReservation.timeKey)
        )
        && getAfter(
          /databases/$(database)/documents/provider_booked_slots/$(previousReservation.providerId)/dates/$(previousReservation.dateKey)/times/$(previousReservation.timeKey)
        ).data.providerId == previousReservation.providerId
        && getAfter(
          /databases/$(database)/documents/provider_booked_slots/$(previousReservation.providerId)/dates/$(previousReservation.dateKey)/times/$(previousReservation.timeKey)
        ).data.dateKey == previousReservation.dateKey
        && getAfter(
          /databases/$(database)/documents/provider_booked_slots/$(previousReservation.providerId)/dates/$(previousReservation.dateKey)/times/$(previousReservation.timeKey)
        ).data.timeString == previousReservation.timeString
        && getAfter(
          /databases/$(database)/documents/provider_booked_slots/$(previousReservation.providerId)/dates/$(previousReservation.dateKey)/times/$(previousReservation.timeKey)
        ).data.reservationId == reservationId
        && getAfter(
          /databases/$(database)/documents/provider_booked_slots/$(previousReservation.providerId)/dates/$(previousReservation.dateKey)/times/$(previousReservation.timeKey)
        ).data.status == nextReservation.status
      )
      ||
      !previousReservation.keys().hasAny([
        "dateKey",
        "timeString",
        "timeKey"
      ]);
    }

    // MARK: - Provider Application History

    match /provider_application_history/{historyId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    // MARK: - Users

    match /users/{userId} {
      // Users can read only their own document.
      // Admins can read any user document.
      allow get: if isOwner(userId) || isAdmin();

      // Only admins can list or query users.
      allow list: if isAdmin();

      allow create: if isOwner(userId)
        && (
          request.resource.data.role == "user"
          || request.resource.data.role == "expert"
        );

      allow update: if isOwner(userId)
        && request.resource.data.role == resource.data.role;

      allow delete: if false;

      // User subcollections are owner-only.
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // MARK: - Reviews

    match /reviews/{reviewId} {
      allow read: if true;

      allow create: if signedIn()
        // Allow only known review fields.
        && request.resource.data.keys().hasAll([
          "reviewId",
          "bookingId",
          "reservationId",
          "customerId",
          "providerId",
          "rating",
          "comment",
          "categoryRatings",
          "photos",
          "isReported",
          "createdAt",
          "updatedAt",
          "helpfulCount",
          "helpfulUsers",
          "customerName",
          "isVerifiedBooking"
        ])
        && request.resource.data.keys().hasOnly([
          "reviewId",
          "bookingId",
          "reservationId",
          "serviceId",
          "serviceTitle",
          "customerId",
          "providerId",
          "rating",
          "comment",
          "categoryRatings",
          "photos",
          "isReported",
          "createdAt",
          "updatedAt",
          "helpfulCount",
          "helpfulUsers",
          "customerName",
          "customerAvatarURL",
          "isVerifiedBooking"
        ])

        // Validate ownership and IDs.
        && request.resource.data.reviewId == reviewId
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.bookingId is string
        && request.resource.data.reservationId is string
        && request.resource.data.reservationId
          == request.resource.data.bookingId
        && request.resource.data.providerId is string
        && request.resource.data.providerId.size() > 0

        // Validate review content.
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 500
        && request.resource.data.categoryRatings is map
        && request.resource.data.photos is list
        && request.resource.data.photos.size() <= 5
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 0
        && request.resource.data.customerName.size() <= 100

        // Validate initial state.
        && request.resource.data.isReported == false
        && request.resource.data.helpfulCount == 0
        && request.resource.data.helpfulUsers is list
        && request.resource.data.helpfulUsers.size() == 0
        && request.resource.data.isVerifiedBooking is bool
        && (
          // General review without a reservation.
          (
            request.resource.data.bookingId == ""
            && request.resource.data.reservationId == ""
            && request.resource.data.isVerifiedBooking == false
          )

          ||

          // Verified review for a completed reservation.
          (
            request.resource.data.bookingId.size() > 0
            && request.resource.data.reservationId
              == request.resource.data.bookingId
            && request.resource.data.isVerifiedBooking == true
            && exists(
              /databases/$(database)/documents/reservations/$(request.resource.data.bookingId)
            )
            && get(
              /databases/$(database)/documents/reservations/$(request.resource.data.bookingId)
            ).data.customerId == request.auth.uid
            && get(
              /databases/$(database)/documents/reservations/$(request.resource.data.bookingId)
            ).data.providerId == request.resource.data.providerId
            && get(
              /databases/$(database)/documents/reservations/$(request.resource.data.bookingId)
            ).data.status == "completed"
          )
        )
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      allow update: if signedIn()
        && (
          // Provider can answer their own review once.
          (
            request.auth.uid == resource.data.providerId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "providerResponse",
              "providerResponseDate",
              "updatedAt"
            ])
            && request.resource.data.providerResponse is string
            && request.resource.data.providerResponse.size() > 0
            && request.resource.data.providerResponse.size() <= 400
            && request.resource.data.providerResponseDate is timestamp
            && request.resource.data.updatedAt is timestamp
            && (
              !resource.data.keys().hasAny(["providerResponse"])
              || resource.data.providerResponse == null
              || resource.data.providerResponse == ""
            )
          )

          ||

          // Signed-in users can toggle only their own helpful state.
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "helpfulUsers",
              "helpfulCount"
            ])
            && resource.data.helpfulUsers is list
            && resource.data.helpfulCount is int
            && resource.data.helpfulCount
              == resource.data.helpfulUsers.size()
            && request.resource.data.helpfulUsers is list
            && request.resource.data.helpfulCount is int
            && request.resource.data.helpfulCount >= 0
            && request.resource.data.helpfulCount
              == request.resource.data.helpfulUsers.size()
            && request.resource.data.helpfulUsers.toSet().size()
              == request.resource.data.helpfulUsers.size()
            && (
              (
                !(request.auth.uid in resource.data.helpfulUsers)
                && request.auth.uid in request.resource.data.helpfulUsers
                && request.resource.data.helpfulCount
                  == resource.data.helpfulCount + 1
                && request.resource.data.helpfulUsers.toSet()
                  .difference(resource.data.helpfulUsers.toSet())
                  .hasOnly([request.auth.uid])
                && resource.data.helpfulUsers.toSet()
                  .difference(request.resource.data.helpfulUsers.toSet())
                  .size() == 0
              )
              ||
              (
                request.auth.uid in resource.data.helpfulUsers
                && !(request.auth.uid in request.resource.data.helpfulUsers)
                && request.resource.data.helpfulCount
                  == resource.data.helpfulCount - 1
                && resource.data.helpfulUsers.toSet()
                  .difference(request.resource.data.helpfulUsers.toSet())
                  .hasOnly([request.auth.uid])
                && request.resource.data.helpfulUsers.toSet()
                  .difference(resource.data.helpfulUsers.toSet())
                  .size() == 0
              )
            )
          )

          ||

          // Users can only mark a review as reported.
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "isReported",
              "updatedAt"
            ])
            && request.resource.data.isReported == true
            && request.resource.data.updatedAt is timestamp
            && existsAfter(
              /databases/$(database)/documents/review_reports/$(reviewId + "_" + request.auth.uid)
            )
          )
        );

      allow delete: if false;
    }


    // MARK: - Review Reports

    match /review_reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          "reportId",
          "reviewId",
          "reporterId",
          "providerId",
          "category",
          "description",
          "status",
          "createdAt"
        ])
        && request.resource.data.keys().hasOnly([
          "reportId",
          "reviewId",
          "reporterId",
          "providerId",
          "category",
          "description",
          "status",
          "createdAt"
        ])
        && request.resource.data.reportId == reportId
        && request.resource.data.reporterId == request.auth.uid
        && reportId
          == request.resource.data.reviewId + "_" + request.auth.uid
        && request.resource.data.reviewId is string
        && request.resource.data.reviewId.size() > 0
        && request.resource.data.providerId is string
        && request.resource.data.providerId.size() > 0
        && request.resource.data.category in [
          "Uygunsuz İçerik",
          "Spam / Reklam",
          "Sahte Yorum",
          "Kişisel Saldırı / Hakaret",
          "Diğer"
        ]
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt is timestamp
        && exists(
          /databases/$(database)/documents/reviews/$(request.resource.data.reviewId)
        )
        && get(
          /databases/$(database)/documents/reviews/$(request.resource.data.reviewId)
        ).data.providerId == request.resource.data.providerId
        && getAfter(
          /databases/$(database)/documents/reviews/$(request.resource.data.reviewId)
        ).data.isReported == true;

      allow read: if signedIn()
        && (
          resource.data.reporterId == request.auth.uid
          || isAdmin()
        );

      allow update: if isAdmin()
        && resource.data.status == "pending"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "resolvedAt",
          "resolvedBy",
          "resolutionNote"
        ])
        && request.resource.data.status in [
          "dismissed",
          "removed"
        ]
        && request.resource.data.resolvedAt is timestamp
        && request.resource.data.resolvedBy == request.auth.uid
        && request.resource.data.resolutionNote is string
        && request.resource.data.resolutionNote.size() <= 500;

      allow delete: if false;
    }


    // MARK: - Review Moderation Archives

    match /review_report_archive/{archiveId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /review_moderation_archive/{reviewId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // MARK: - Services
    match /services/{serviceId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.providerId == request.auth.uid;

      allow update: if signedIn()
        && resource.data.providerId == request.auth.uid
        && request.resource.data.providerId == resource.data.providerId;

      allow delete: if signedIn()
        && resource.data.providerId == request.auth.uid;
    }

    // MARK: - Service Providers

    match /service_providers/{providerId} {
      allow read: if signedIn();

      // Provider can create only their own draft profile.
      allow create: if isOwner(providerId)
        && request.resource.data.providerId == providerId
        && request.resource.data.status in [
          "Draft",
          "draft"
        ]
        && request.resource.data.isActive == false
        && request.resource.data.rating == 0
        && !request.resource.data.keys().hasAny([
          "email",
          "phoneNumber",
          "taxNumber",
          "bankName",
          "iban",
          "accountHolderName",
          "certificateURLs",
          "idFrontURL",
          "idBackURL",
          "verificationStatus",
          "adminNote",
          "applicationDecision",
          "reviewedAt",
          "reviewedBy"
        ]);

      allow update: if isOwner(providerId)
        && resource.data.providerId == providerId
        && request.resource.data.providerId == providerId

        // Sensitive fields must never exist in this public document.
        && !request.resource.data.keys().hasAny([
          "email",
          "phoneNumber",
          "taxNumber",
          "bankName",
          "iban",
          "accountHolderName",
          "certificateURLs",
          "idFrontURL",
          "idBackURL"
        ])

        && (
          // Normal public profile update.
          (
            !request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasAny([
                "providerId",
                "status",
                "verificationStatus",
                "adminNote",
                "applicationDecision",
                "reviewedAt",
                "reviewedBy",
                "createdAt",
                "isActive",
                "rating",
                "reviewCount",
                "completedJobsCount"
              ])
          )

          ||

          // Provider can submit only an allowed application.
          (
            request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasOnly([
                "status"
              ])
            && request.resource.data.status == "Pending"
            && resource.data.status in [
              "Draft",
              "draft",
              "rejected",
              "Rejected",
              "documentsRequired",
              "DocumentsRequired",
              "documentsrequired"
            ]
          )
        );

      allow delete: if false;
    }

    // MARK: - Provider Private Data

    match /provider_private_data/{providerId} {
      allow get: if isOwner(providerId) || isAdmin();
      allow list: if isAdmin();

      allow create: if isOwner(providerId)
        && request.resource.data.providerId == providerId
        && request.resource.data.keys().hasOnly([
          "providerId",
          "email",
          "phoneNumber",
          "taxNumber",
          "bankName",
          "iban",
          "accountHolderName",
          "certificateURLs",
          "idFrontURL",
          "idBackURL",
          "createdAt",
          "updatedAt"
        ]);

      allow update: if isOwner(providerId)
        && resource.data.providerId == providerId
        && request.resource.data.providerId == providerId
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "email",
            "phoneNumber",
            "taxNumber",
            "bankName",
            "iban",
            "accountHolderName",
            "certificateURLs",
            "idFrontURL",
            "idBackURL",
            "updatedAt"
          ]);

      allow delete: if false;
    }

    // MARK: - Reservations

    match /reservations/{reservationId} {
      // Provider veya müşteri kendi rezervasyonunu okuyabilir.
      // List sorgularında (whereField ile) resource.data boş olduğundan
      // geniş "signedIn()" izni verilir; Firestore zaten sadece match eden
      // dokümanları döndürür ve her doküman "get" rule'ıyla ayrıca doğrulanır.
      allow list: if signedIn();

      allow get: if signedIn()
        && (
          resource.data.customerId == request.auth.uid
          || resource.data.providerId == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.reservationId == reservationId
        && request.resource.data.status == "pending"

        && request.resource.data.serviceId is string
        && request.resource.data.providerId is string
        && request.resource.data.reservationDate is timestamp
        && request.resource.data.dateKey is string
        && request.resource.data.timeString is string
        && request.resource.data.timeKey is string

        && request.resource.data.dateKey.matches("^[0-9]{8}$")
        && request.resource.data.timeString.matches(
          "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        )
        && request.resource.data.timeKey.matches("^[0-9]{4}$")
        && request.resource.data.timeKey
          == request.resource.data.timeString.replace(":", "")

        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time

        && request.resource.data.keys().hasAll([
          "reservationId",
          "serviceId",
          "serviceTitle",
          "servicePrice",
          "serviceDuration",
          "providerId",
          "providerName",
          "customerId",
          "customerName",
          "reservationDate",
          "dateKey",
          "timeString",
          "timeKey",
          "addressText",
          "note",
          "status",
          "createdAt",
          "updatedAt"
        ])

        && request.resource.data.keys().hasOnly([
          "reservationId",
          "serviceId",
          "serviceTitle",
          "servicePrice",
          "serviceDuration",
          "providerId",
          "providerName",
          "customerId",
          "customerName",
          "reservationDate",
          "dateKey",
          "timeString",
          "timeKey",
          "addressText",
          "note",
          "status",
          "createdAt",
          "updatedAt"
        ])

        && exists(
          /databases/$(database)/documents/services/$(request.resource.data.serviceId)
        )
        && get(
          /databases/$(database)/documents/services/$(request.resource.data.serviceId)
        ).data.providerId == request.resource.data.providerId
        && get(
          /databases/$(database)/documents/services/$(request.resource.data.serviceId)
        ).data.isActive == true
        && (
          !get(
            /databases/$(database)/documents/services/$(request.resource.data.serviceId)
          ).data.keys().hasAny(["isAvailable"])
          ||
          get(
            /databases/$(database)/documents/services/$(request.resource.data.serviceId)
          ).data.isAvailable == true
        )

        && exists(
          /databases/$(database)/documents/service_providers/$(request.resource.data.providerId)
        )
        && (
          !get(
            /databases/$(database)/documents/service_providers/$(request.resource.data.providerId)
          ).data.keys().hasAny(["isAvailable"])
          ||
          get(
            /databases/$(database)/documents/service_providers/$(request.resource.data.providerId)
          ).data.isAvailable == true
        )

        && existsAfter(
          /databases/$(database)/documents/provider_booked_slots/$(request.resource.data.providerId)/dates/$(request.resource.data.dateKey)/times/$(request.resource.data.timeKey)
        )
        && getAfter(
          /databases/$(database)/documents/provider_booked_slots/$(request.resource.data.providerId)/dates/$(request.resource.data.dateKey)/times/$(request.resource.data.timeKey)
        ).data.providerId == request.resource.data.providerId
        && getAfter(
          /databases/$(database)/documents/provider_booked_slots/$(request.resource.data.providerId)/dates/$(request.resource.data.dateKey)/times/$(request.resource.data.timeKey)
        ).data.dateKey == request.resource.data.dateKey
        && getAfter(
          /databases/$(database)/documents/provider_booked_slots/$(request.resource.data.providerId)/dates/$(request.resource.data.dateKey)/times/$(request.resource.data.timeKey)
        ).data.timeString == request.resource.data.timeString
        && getAfter(
          /databases/$(database)/documents/provider_booked_slots/$(request.resource.data.providerId)/dates/$(request.resource.data.dateKey)/times/$(request.resource.data.timeKey)
        ).data.reservationId == reservationId
        && getAfter(
          /databases/$(database)/documents/provider_booked_slots/$(request.resource.data.providerId)/dates/$(request.resource.data.dateKey)/times/$(request.resource.data.timeKey)
        ).data.status == "pending";

      allow update: if signedIn()
        && request.resource.data.updatedAt is timestamp
        && reservationSlotMatchesAfter(
          reservationId,
          resource.data,
          request.resource.data
        )
        && (
          (
            resource.data.customerId == request.auth.uid
            && resource.data.status in ["pending", "accepted"]
            && request.resource.data.status == "cancelled"
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "status",
              "updatedAt"
            ])
          )
          ||
          (
            resource.data.providerId == request.auth.uid
            && resource.data.status == "pending"
            && request.resource.data.status == "accepted"
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "status",
              "updatedAt"
            ])
          )
          ||
          (
            resource.data.providerId == request.auth.uid
            && resource.data.status == "pending"
            && request.resource.data.status == "rejected"
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "status",
              "updatedAt",
              "rejectionReason"
            ])
            && request.resource.data.rejectionReason is string
            && request.resource.data.rejectionReason.size() > 0
            && request.resource.data.rejectionReason.size() <= 200
          )
          ||
          (
            resource.data.providerId == request.auth.uid
            && resource.data.status == "accepted"
            && request.resource.data.status == "inProgress"
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "status",
              "updatedAt",
              "startedAt"
            ])
            && request.resource.data.startedAt is timestamp
          )
          ||
          (
            resource.data.providerId == request.auth.uid
            && resource.data.status == "accepted"
            && request.resource.data.status == "noShow"
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "status",
              "updatedAt",
              "noShowAt"
            ])
            && request.resource.data.noShowAt is timestamp
          )
          ||
          (
            resource.data.providerId == request.auth.uid
            && resource.data.status == "inProgress"
            && request.resource.data.status == "completed"
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "status",
              "updatedAt",
              "completedAt"
            ])
            && request.resource.data.completedAt is timestamp
          )
        );

      allow delete: if false;
    }

    // MARK: - Portfolio (Uzman Portföyü)

    match /portfolio/{userId} {
      // İç koleksiyona erişmek için parent dokümanın okunması gerekebilir.
      allow read: if signedIn();
      allow write: if false;

      match /items/{itemId} {
        // Herkes okuyabilir (profil sayfasında müşteriler de görür)
        allow read: if true;

        // Sadece sahip yazabilir/silebilir
        allow create, update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
    }

    // MARK: - Withdrawal Requests (Para Çekme Talepleri)

    match /withdrawal_requests/{userId} {
      allow read: if false;
      allow write: if false;

      match /requests/{requestId} {
        // Sadece kendi taleplerini okuyabilir
        allow read: if isOwner(userId);

        // Sadece kendi adına talep oluşturabilir
        allow create: if isOwner(userId)
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.bankName is string
          && request.resource.data.bankName.size() > 0
          && request.resource.data.iban is string
          && request.resource.data.iban.size() > 0
          && request.resource.data.status == "Beklemede"
          && request.resource.data.createdAt is timestamp;

        // Güncelleme ve silme yasak (admin işler)
        allow update, delete: if false;
      }
    }

    // MARK: - Provider Booked Slots

    match /provider_booked_slots/{providerId} {
      allow get, list: if signedIn();

      match /dates/{dateKey} {
        allow get, list: if signedIn();

        match /times/{timeKey} {
          allow get, list: if signedIn();

          allow create: if signedIn()
            && request.resource.data.providerId == providerId
            && request.resource.data.dateKey == dateKey
            && request.resource.data.timeString is string
            && request.resource.data.timeString.matches(
              "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            )
            && timeKey
              == request.resource.data.timeString.replace(":", "")
            && request.resource.data.status == "pending"
            && request.resource.data.reservationId is string
            && request.resource.data.reservationId.size() > 0
            && request.resource.data.createdAt == request.time
            && request.resource.data.updatedAt == request.time
            && request.resource.data.keys().hasAll([
              "providerId",
              "dateKey",
              "timeString",
              "status",
              "reservationId",
              "createdAt",
              "updatedAt"
            ])
            && request.resource.data.keys().hasOnly([
              "providerId",
              "dateKey",
              "timeString",
              "status",
              "reservationId",
              "createdAt",
              "updatedAt"
            ])
            && existsAfter(
              /databases/$(database)/documents/reservations/$(request.resource.data.reservationId)
            )
            && getAfter(
              /databases/$(database)/documents/reservations/$(request.resource.data.reservationId)
            ).data.reservationId == request.resource.data.reservationId
            && getAfter(
              /databases/$(database)/documents/reservations/$(request.resource.data.reservationId)
            ).data.customerId == request.auth.uid
            && getAfter(
              /databases/$(database)/documents/reservations/$(request.resource.data.reservationId)
            ).data.providerId == providerId
            && getAfter(
              /databases/$(database)/documents/reservations/$(request.resource.data.reservationId)
            ).data.dateKey == dateKey
            && getAfter(
              /databases/$(database)/documents/reservations/$(request.resource.data.reservationId)
            ).data.timeString == request.resource.data.timeString
            && getAfter(
              /databases/$(database)/documents/reservations/$(request.resource.data.reservationId)
            ).data.timeKey == timeKey
            && getAfter(
              /databases/$(database)/documents/reservations/$(request.resource.data.reservationId)
            ).data.status == "pending";

          allow update: if signedIn()
            && (
              (
                resource.data.status in ["cancelled", "rejected"]
                && request.resource.data.diff(resource.data)
                  .affectedKeys().hasOnly([
                    "status",
                    "reservationId",
                    "createdAt",
                    "updatedAt"
                  ])
                && request.resource.data.providerId == providerId
                && request.resource.data.providerId
                  == resource.data.providerId
                && request.resource.data.dateKey == dateKey
                && request.resource.data.dateKey
                  == resource.data.dateKey
                && request.resource.data.timeString
                  == resource.data.timeString
                && request.resource.data.timeString is string
                && request.resource.data.timeString.matches(
                  "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                )
                && timeKey
                  == request.resource.data.timeString.replace(":", "")
                && request.resource.data.status == "pending"
                && request.resource.data.reservationId is string
                && request.resource.data.reservationId.size() > 0
                && request.resource.data.createdAt == request.time
                && request.resource.data.updatedAt == request.time
                && request.resource.data.keys().hasAll([
                  "providerId",
                  "dateKey",
                  "timeString",
                  "status",
                  "reservationId",
                  "createdAt",
                  "updatedAt"
                ])
                && request.resource.data.keys().hasOnly([
                  "providerId",
                  "dateKey",
                  "timeString",
                  "status",
                  "reservationId",
                  "createdAt",
                  "updatedAt"
                ])
                && existsAfter(
                  /databases/$(database)/documents/reservations/$(request.resource.data.reservationId)
                )
                && getAfter(
                  /databases/$(database)/documents/reservations/$(request.resource.data.reservationId)
                ).data.reservationId
                  == request.resource.data.reservationId
                && getAfter(
                  /databases/$(database)/documents/reservations/$(request.resource.data.reservationId)
                ).data.customerId == request.auth.uid
                && getAfter(
                  /databases/$(database)/documents/reservations/$(request.resource.data.reservationId)
                ).data.providerId == providerId
                && getAfter(
                  /databases/$(database)/documents/reservations/$(request.resource.data.reservationId)
                ).data.dateKey == dateKey
                && getAfter(
                  /databases/$(database)/documents/reservations/$(request.resource.data.reservationId)
                ).data.timeString
                  == request.resource.data.timeString
                && getAfter(
                  /databases/$(database)/documents/reservations/$(request.resource.data.reservationId)
                ).data.timeKey == timeKey
                && getAfter(
                  /databases/$(database)/documents/reservations/$(request.resource.data.reservationId)
                ).data.status == "pending"
              )
              ||
              (
                request.resource.data.diff(resource.data)
                  .affectedKeys().hasOnly([
                    "status",
                    "updatedAt"
                  ])
                && request.resource.data.providerId
                  == resource.data.providerId
                && request.resource.data.providerId == providerId
                && request.resource.data.dateKey
                  == resource.data.dateKey
                && request.resource.data.dateKey == dateKey
                && request.resource.data.timeString
                  == resource.data.timeString
                && timeKey
                  == request.resource.data.timeString.replace(":", "")
                && request.resource.data.reservationId
                  == resource.data.reservationId
                && request.resource.data.updatedAt is timestamp
                && request.resource.data.status in [
                  "accepted",
                  "rejected",
                  "cancelled",
                  "inProgress",
                  "completed",
                  "noShow"
                ]
                && existsAfter(
                  /databases/$(database)/documents/reservations/$(resource.data.reservationId)
                )
                && getAfter(
                  /databases/$(database)/documents/reservations/$(resource.data.reservationId)
                ).data.reservationId == resource.data.reservationId
                && getAfter(
                  /databases/$(database)/documents/reservations/$(resource.data.reservationId)
                ).data.providerId == providerId
                // Support old reservations until data migration
                && (
                  (
                    getAfter(
                      /databases/$(database)/documents/reservations/$(resource.data.reservationId)
                    ).data.keys().hasAll([
                      "dateKey",
                      "timeString",
                      "timeKey"
                    ])
                    && getAfter(
                      /databases/$(database)/documents/reservations/$(resource.data.reservationId)
                    ).data.dateKey == dateKey
                    && getAfter(
                      /databases/$(database)/documents/reservations/$(resource.data.reservationId)
                    ).data.timeString
                      == request.resource.data.timeString
                    && getAfter(
                      /databases/$(database)/documents/reservations/$(resource.data.reservationId)
                    ).data.timeKey == timeKey
                  )
                  ||
                  (
                    !getAfter(
                      /databases/$(database)/documents/reservations/$(resource.data.reservationId)
                    ).data.keys().hasAny([
                      "dateKey",
                      "timeString",
                      "timeKey"
                    ])
                  )
                )
                && getAfter(
                  /databases/$(database)/documents/reservations/$(resource.data.reservationId)
                ).data.status == request.resource.data.status
                && (
                  (
                    getAfter(
                      /databases/$(database)/documents/reservations/$(resource.data.reservationId)
                    ).data.customerId == request.auth.uid
                    && request.resource.data.status == "cancelled"
                  )
                  ||
                  (
                    getAfter(
                      /databases/$(database)/documents/reservations/$(resource.data.reservationId)
                    ).data.providerId == request.auth.uid
                    && request.resource.data.status in [
                      "accepted",
                      "rejected",
                      "inProgress",
                      "completed",
                      "noShow"
                    ]
                  )
                )
              )
            );

          allow delete: if false;
        }
      }
    }

    // MARK: - Conversations

    match /conversations/{conversationId} {
      allow get: if signedIn()
        && (
          !exists(/databases/$(database)/documents/conversations/$(conversationId))
          || request.auth.uid in resource.data.participantIds
        );

      allow list: if signedIn()
        && request.auth.uid in resource.data.participantIds;

      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantIds.size() == 2
        && request.resource.data.keys().hasOnly([
          "participantIds",
          "participantNames",
          "participantPhotoURLs",
          "lastMessage",
          "lastMessageAt",
          "unreadCounts",
          "createdAt",
          "updatedAt"
        ]);

      allow update: if signedIn()
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "lastMessage",
          "lastMessageAt",
          "updatedAt",
          "unreadCounts"
        ]);

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isConversationParticipant(conversationId);

        allow create: if isConversationParticipant(conversationId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderId in get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.participantIds
          && request.resource.data.receiverId in get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.participantIds
          && request.resource.data.senderId != request.resource.data.receiverId
          && request.resource.data.conversationId == conversationId
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.isRead == false
          && request.resource.data.keys().hasOnly([
            "conversationId",
            "senderId",
            "receiverId",
            "text",
            "sentAt",
            "isRead"
          ]);

        allow update: if isConversationParticipant(conversationId)
          && resource.data.receiverId == request.auth.uid
          && resource.data.isRead == false
          && request.resource.data.isRead == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "isRead"
          ]);

        allow delete: if false;
      }
    }
  }
}
